<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_xor_simple"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.28.0">

  <!-- XOR_Simple: Start → TaskPre → XOR split →
         Branch1 (condition): TaskA1 → TaskA2
         Branch2 (default):   TaskB1 → TaskB2
       → XOR merge → TaskPost → End -->
  <bpmn:process id="Process_XOR_Simple" name="XOR_Simple" isExecutable="false">

    <bpmn:startEvent id="Start_1" name="start">
      <bpmn:outgoing>Flow_s_to_pre</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_Pre" name="Prepare">
      <bpmn:incoming>Flow_s_to_pre</bpmn:incoming>
      <bpmn:outgoing>Flow_pre_to_xsplit</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="XOR_Split" default="Flow_x_to_B1">
      <bpmn:incoming>Flow_pre_to_xsplit</bpmn:incoming>
      <bpmn:outgoing>Flow_x_to_A1</bpmn:outgoing>
      <bpmn:outgoing>Flow_x_to_B1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Branch 1: with condition -->
    <bpmn:scriptTask id="Task_A1" name="CheckSensor">
      <bpmn:incoming>Flow_x_to_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A1_to_A2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_A2" name="ProcessData">
      <bpmn:incoming>Flow_A1_to_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A2_to_xmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- Branch 2: default (no condition) -->
    <bpmn:scriptTask id="Task_B1" name="LogError">
      <bpmn:incoming>Flow_x_to_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B1_to_B2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_B2" name="NotifyAdmin">
      <bpmn:incoming>Flow_B1_to_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B2_to_xmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="XOR_Merge">
      <bpmn:incoming>Flow_A2_to_xmerge</bpmn:incoming>
      <bpmn:incoming>Flow_B2_to_xmerge</bpmn:incoming>
      <bpmn:outgoing>Flow_xm_to_post</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_Post" name="Cleanup">
      <bpmn:incoming>Flow_xm_to_post</bpmn:incoming>
      <bpmn:outgoing>Flow_post_to_end</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="end">
      <bpmn:incoming>Flow_post_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_s_to_pre" sourceRef="Start_1" targetRef="Task_Pre" />
    <bpmn:sequenceFlow id="Flow_pre_to_xsplit" sourceRef="Task_Pre" targetRef="XOR_Split" />
    <bpmn:sequenceFlow id="Flow_x_to_A1" sourceRef="XOR_Split" targetRef="Task_A1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">x &gt; 10</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_x_to_B1" sourceRef="XOR_Split" targetRef="Task_B1" />
    <bpmn:sequenceFlow id="Flow_A1_to_A2" sourceRef="Task_A1" targetRef="Task_A2" />
    <bpmn:sequenceFlow id="Flow_A2_to_xmerge" sourceRef="Task_A2" targetRef="XOR_Merge" />
    <bpmn:sequenceFlow id="Flow_B1_to_B2" sourceRef="Task_B1" targetRef="Task_B2" />
    <bpmn:sequenceFlow id="Flow_B2_to_xmerge" sourceRef="Task_B2" targetRef="XOR_Merge" />
    <bpmn:sequenceFlow id="Flow_xm_to_post" sourceRef="XOR_Merge" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="Flow_post_to_end" sourceRef="Task_Post" targetRef="End_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_XOR_Simple">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pre_di" bpmnElement="Task_Pre"><dc:Bounds x="240" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Split_di" bpmnElement="XOR_Split" isMarkerVisible="true"><dc:Bounds x="395" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A1_di" bpmnElement="Task_A1"><dc:Bounds x="500" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A2_di" bpmnElement="Task_A2"><dc:Bounds x="650" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B1_di" bpmnElement="Task_B1"><dc:Bounds x="500" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B2_di" bpmnElement="Task_B2"><dc:Bounds x="650" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Merge_di" bpmnElement="XOR_Merge" isMarkerVisible="true"><dc:Bounds x="805" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Post_di" bpmnElement="Task_Post"><dc:Bounds x="910" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="1062" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_s_to_pre_di" bpmnElement="Flow_s_to_pre"><di:waypoint x="188" y="250" /><di:waypoint x="240" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_pre_to_xsplit_di" bpmnElement="Flow_pre_to_xsplit"><di:waypoint x="340" y="250" /><di:waypoint x="395" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_x_to_A1_di" bpmnElement="Flow_x_to_A1"><di:waypoint x="420" y="225" /><di:waypoint x="420" y="140" /><di:waypoint x="500" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_x_to_B1_di" bpmnElement="Flow_x_to_B1"><di:waypoint x="420" y="275" /><di:waypoint x="420" y="350" /><di:waypoint x="500" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A1_to_A2_di" bpmnElement="Flow_A1_to_A2"><di:waypoint x="600" y="140" /><di:waypoint x="650" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A2_to_xmerge_di" bpmnElement="Flow_A2_to_xmerge"><di:waypoint x="750" y="140" /><di:waypoint x="830" y="140" /><di:waypoint x="830" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B1_to_B2_di" bpmnElement="Flow_B1_to_B2"><di:waypoint x="600" y="350" /><di:waypoint x="650" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_to_xmerge_di" bpmnElement="Flow_B2_to_xmerge"><di:waypoint x="750" y="350" /><di:waypoint x="830" y="350" /><di:waypoint x="830" y="275" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_xm_to_post_di" bpmnElement="Flow_xm_to_post"><di:waypoint x="855" y="250" /><di:waypoint x="910" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_post_to_end_di" bpmnElement="Flow_post_to_end"><di:waypoint x="1010" y="250" /><di:waypoint x="1062" y="250" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
