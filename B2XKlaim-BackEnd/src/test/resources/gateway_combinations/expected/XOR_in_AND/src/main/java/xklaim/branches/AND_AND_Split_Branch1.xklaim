package xklaim.branches

import klava.Locality

proc AND_AND_Split_Branch1() {

  if (status == "ok"){
    eval(new ValidateInput('Flow_A1_to_A2'/* TODO: Pass other necessary args */))@self
    in('Flow_A1_to_A2')@self

    eval(new TransformData('Flow_A2_to_xmerge'/* TODO: Pass other necessary args */))@self
    in('Flow_A2_to_xmerge')@self

  } else {
    eval(new UseDefaults('Flow_B1_to_B2'/* TODO: Pass other necessary args */))@self
    in('Flow_B1_to_B2')@self

    eval(new LogDefault('Flow_B2_to_xmerge'/* TODO: Pass other necessary args */))@self
    in('Flow_B2_to_xmerge')@self

  }

  out('Flow_xm_to_amerge')@self
}
