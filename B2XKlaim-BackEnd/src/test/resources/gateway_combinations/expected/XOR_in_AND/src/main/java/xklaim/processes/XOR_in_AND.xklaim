package xklaim.processes

import klava.Locality
import xklaim.tasks.Setup
import xklaim.tasks.Aggregate
import xklaim.branches.AND_AND_Split_Branch0
import xklaim.branches.AND_AND_Split_Branch1

proc XOR_in_AND() {


  eval(new Setup('Flow_pre_to_asplit'/* TODO: Pass other necessary args */))@self
  in('Flow_pre_to_asplit')@self

  eval(new AND_AND_Split_Branch0())@self
  eval(new AND_AND_Split_Branch1())@self
  in('Flow_C2_to_amerge')@self
  in('Flow_xm_to_amerge')@self

  eval(new Aggregate('Flow_post_to_end'/* TODO: Pass other necessary args */))@self
  in('Flow_post_to_end')@self
}
