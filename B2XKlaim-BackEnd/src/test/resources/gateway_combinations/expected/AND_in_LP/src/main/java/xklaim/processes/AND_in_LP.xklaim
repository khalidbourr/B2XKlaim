package xklaim.processes

import klava.Locality
import xklaim.tasks.OpenConnection
import xklaim.tasks.CloseConnection
import xklaim.branches.AND_AND_Split_Branch0
import xklaim.branches.AND_AND_Split_Branch1

proc AND_in_LP() {


  eval(new OpenConnection('Flow_pre_to_asplit'/* TODO: Pass other necessary args */))@self
  in('Flow_pre_to_asplit')@self

  eval(new AND_AND_Split_Branch0())@self
  eval(new AND_AND_Split_Branch1())@self
  in('Flow_A1_to_amerge')@self
  in('Flow_B2_to_amerge')@self

  eval(new CloseConnection('Flow_post_to_end'/* TODO: Pass other necessary args */))@self
  in('Flow_post_to_end')@self
}
