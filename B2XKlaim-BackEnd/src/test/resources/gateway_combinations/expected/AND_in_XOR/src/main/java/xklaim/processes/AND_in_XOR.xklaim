package xklaim.processes

import klava.Locality
import xklaim.tasks.LogSkipped
import xklaim.tasks.LoadConfig
import xklaim.tasks.CopyRawFile
import xklaim.tasks.Publish
import xklaim.branches.AND_AND_Split_Branch0
import xklaim.branches.AND_AND_Split_Branch1

proc AND_in_XOR() {


  eval(new LoadConfig('Flow_pre_to_xsplit'/* TODO: Pass other necessary args */))@self
  in('Flow_pre_to_xsplit')@self

  if (needsProcessing == true){
    eval(new AND_AND_Split_Branch0())@self
    eval(new AND_AND_Split_Branch1())@self
    in('Flow_A2_to_amerge')@self
    in('Flow_B2_to_amerge')@self

  } else {
    eval(new CopyRawFile('Flow_C1_to_C2'/* TODO: Pass other necessary args */))@self
    in('Flow_C1_to_C2')@self

    eval(new LogSkipped('Flow_C2_to_xmerge'/* TODO: Pass other necessary args */))@self
    in('Flow_C2_to_xmerge')@self

  }


  eval(new Publish('Flow_post_to_end'/* TODO: Pass other necessary args */))@self
  in('Flow_post_to_end')@self
}
