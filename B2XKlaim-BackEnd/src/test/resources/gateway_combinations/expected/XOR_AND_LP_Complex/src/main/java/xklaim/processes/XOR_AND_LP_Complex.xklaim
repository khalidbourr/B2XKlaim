package xklaim.processes

import klava.Locality
import xklaim.tasks.VerifyStatus
import xklaim.tasks.ConsolidateResults
import xklaim.tasks.RecoverState
import xklaim.tasks.PrepareRetry
import xklaim.tasks.BootSystem
import xklaim.tasks.WriteOutput
import xklaim.tasks.Shutdown
import xklaim.tasks.RetryConnection
import xklaim.tasks.LoadConfig
import xklaim.tasks.LogFallback
import xklaim.branches.AND_AND1_Split_Branch0
import xklaim.branches.AND_AND1_Split_Branch1

proc XOR_AND_LP_Complex() {


  eval(new BootSystem('Flow_init_to_config'/* TODO: Pass other necessary args */))@self
  in('Flow_init_to_config')@self

  eval(new LoadConfig('Flow_config_to_xsplit'/* TODO: Pass other necessary args */))@self
  in('Flow_config_to_xsplit')@self

  if (systemReady == true){
    eval(new AND_AND1_Split_Branch0())@self
    eval(new AND_AND1_Split_Branch1())@self
    in('Flow_Report_to_a1merge')@self
    in('Flow_Alert_to_a1merge')@self

    eval(new ConsolidateResults('Flow_MergeData_to_x1merge'/* TODO: Pass other necessary args */))@self
    in('Flow_MergeData_to_x1merge')@self

  } else {
    eval(new LogFallback('Flow_F1_to_F2'/* TODO: Pass other necessary args */))@self
    in('Flow_F1_to_F2')@self

    eval(new PrepareRetry('Flow_F2_to_lp2merge'/* TODO: Pass other necessary args */))@self
    in('Flow_F2_to_lp2merge')@self

    while(retryCount < maxRetries){
      eval(new RetryConnection('Flow_Retry_to_Check'/* TODO: Pass other necessary args */))@self
      in('Flow_Retry_to_Check')@self

      eval(new VerifyStatus('Flow_Check_to_lp2split'/* TODO: Pass other necessary args */))@self
      in('Flow_Check_to_lp2split')@self

    }


    eval(new RecoverState('Flow_Recover_to_x1merge'/* TODO: Pass other necessary args */))@self
    in('Flow_Recover_to_x1merge')@self

  }


  eval(new WriteOutput('Flow_Finalize_to_Shutdown'/* TODO: Pass other necessary args */))@self
  in('Flow_Finalize_to_Shutdown')@self

  eval(new Shutdown('Flow_Shutdown_to_end'/* TODO: Pass other necessary args */))@self
  in('Flow_Shutdown_to_end')@self
}
