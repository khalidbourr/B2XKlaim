package xklaim.processes

import klava.Locality
import xklaim.tasks.Report
import xklaim.tasks.LogError
import xklaim.tasks.CheckSensor
import xklaim.tasks.Prepare
import xklaim.tasks.UpdateState
import xklaim.tasks.ReadSensor
import xklaim.tasks.ProcessData

proc DataConditions() {


  eval(new Prepare('Flow_pre_to_xsplit'/* TODO: Pass other necessary args */))@self
  in('Flow_pre_to_xsplit')@self

  read('state', var Integer XOR_Split_retries, var Integer XOR_Split_counter)@self
  if (XOR_Split_retries < 3){
    eval(new CheckSensor('Flow_A1_to_A2'/* TODO: Pass other necessary args */))@self
    in('Flow_A1_to_A2')@self

    eval(new ProcessData('Flow_A2_to_xmerge'/* TODO: Pass other necessary args */))@self
    in('Flow_A2_to_xmerge')@self

  } else {
    eval(new LogError('Flow_B1_to_xmerge'/* TODO: Pass other necessary args */))@self
    in('Flow_B1_to_xmerge')@self

  }


  var Integer LP_Merge_retries
  var Integer LP_Merge_counter
  do {
    eval(new ReadSensor('Flow_L1_to_L2'/* TODO: Pass other necessary args */))@self
    in('Flow_L1_to_L2')@self

    eval(new UpdateState('Flow_L2_to_lsplit'/* TODO: Pass other necessary args */))@self
    in('Flow_L2_to_lsplit')@self

    read('state', var Integer LP_Merge_r_retries, var Integer LP_Merge_r_counter)@self
    LP_Merge_counter = LP_Merge_r_counter
    LP_Merge_retries = LP_Merge_r_retries
  } while(LP_Merge_counter < 5)

  eval(new Report('Flow_post_to_end'/* TODO: Pass other necessary args */))@self
  in('Flow_post_to_end')@self
}
