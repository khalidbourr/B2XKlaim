package xklaim.processes

import klava.Locality
import xklaim.tasks.IncrementCounter
import xklaim.tasks.FetchItem
import xklaim.tasks.ParseJSON
import xklaim.tasks.InitLoop
import xklaim.tasks.ParseXML
import xklaim.tasks.StoreRecord
import xklaim.tasks.Summary
import xklaim.tasks.StoreLegacy

proc LP_with_XOR() {


  eval(new InitLoop('Flow_pre_to_lmerge'/* TODO: Pass other necessary args */))@self
  in('Flow_pre_to_lmerge')@self

  while(hasMoreItems == true){
    eval(new FetchItem('Flow_L1_to_xsplit'/* TODO: Pass other necessary args */))@self
    in('Flow_L1_to_xsplit')@self

    if (format == "json"){
      eval(new ParseJSON('Flow_A1_to_A2'/* TODO: Pass other necessary args */))@self
      in('Flow_A1_to_A2')@self

      eval(new StoreRecord('Flow_A2_to_xmerge'/* TODO: Pass other necessary args */))@self
      in('Flow_A2_to_xmerge')@self

    } else {
      eval(new ParseXML('Flow_B1_to_B2'/* TODO: Pass other necessary args */))@self
      in('Flow_B1_to_B2')@self

      eval(new StoreLegacy('Flow_B2_to_xmerge'/* TODO: Pass other necessary args */))@self
      in('Flow_B2_to_xmerge')@self

    }


    eval(new IncrementCounter('Flow_L2_to_lsplit'/* TODO: Pass other necessary args */))@self
    in('Flow_L2_to_lsplit')@self

  }


  eval(new Summary('Flow_post_to_end'/* TODO: Pass other necessary args */))@self
  in('Flow_post_to_end')@self
}
