<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_eb4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:collaboration id="Collab_EB4">
    <bpmn:participant id="Part_Producer" name="Producer" processRef="Proc_Producer" />
    <bpmn:participant id="Part_Consumer" name="Consumer" processRef="Proc_Consumer" />
    <bpmn:messageFlow id="MF_Data" name="data" sourceRef="Evt_SendData" targetRef="Evt_CatchData" />
  </bpmn:collaboration>

  <!-- Producer: Start → Build(ST) → SendData(MIT) → Confirm(ST) → End -->
  <bpmn:process id="Proc_Producer" name="ProducerProc" isExecutable="false">
    <bpmn:startEvent id="Start_P" name="start">
      <bpmn:outgoing>Fp_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Build" name="BuildPayload">
      <bpmn:incoming>Fp_1</bpmn:incoming>
      <bpmn:outgoing>Fp_2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Evt_SendData" name="sendData">
      <bpmn:incoming>Fp_2</bpmn:incoming>
      <bpmn:outgoing>Fp_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_SendData" messageRef="Msg_Data" />
    </bpmn:intermediateThrowEvent>
    <bpmn:scriptTask id="Task_Confirm" name="Confirm">
      <bpmn:incoming>Fp_3</bpmn:incoming>
      <bpmn:outgoing>Fp_4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_P" name="end">
      <bpmn:incoming>Fp_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fp_1" sourceRef="Start_P" targetRef="Task_Build" />
    <bpmn:sequenceFlow id="Fp_2" sourceRef="Task_Build" targetRef="Evt_SendData" />
    <bpmn:sequenceFlow id="Fp_3" sourceRef="Evt_SendData" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Fp_4" sourceRef="Task_Confirm" targetRef="End_P" />
  </bpmn:process>

  <!-- Consumer: Start → Init(ST) → EB Gateway →
         Path1 (msg): CatchData → XOR split → (cond: Validate(ST)→Store(ST)) / (default: LogInvalid(ST)→Discard(ST)) → XOR merge
         Path2 (timer 10s): UseDefault(ST) → LogTimeout(ST)
       → XOR merge → Report(ST) → End -->
  <bpmn:process id="Proc_Consumer" name="ConsumerProc" isExecutable="false">
    <bpmn:startEvent id="Start_C" name="start">
      <bpmn:outgoing>Fc_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Init" name="Init">
      <bpmn:incoming>Fc_1</bpmn:incoming>
      <bpmn:outgoing>Fc_2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:eventBasedGateway id="EB_Wait">
      <bpmn:incoming>Fc_2</bpmn:incoming>
      <bpmn:outgoing>Fc_to_msg</bpmn:outgoing>
      <bpmn:outgoing>Fc_to_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Path 1: message → XOR(Validate→Store / LogInvalid→Discard) -->
    <bpmn:intermediateCatchEvent id="Evt_CatchData" name="getData">
      <bpmn:incoming>Fc_to_msg</bpmn:incoming>
      <bpmn:outgoing>Fc_msg_to_xor</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CatchData" messageRef="Msg_Data" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="XOR_Valid_Split" default="Fc_xor_to_invalid">
      <bpmn:incoming>Fc_msg_to_xor</bpmn:incoming>
      <bpmn:outgoing>Fc_xor_to_valid</bpmn:outgoing>
      <bpmn:outgoing>Fc_xor_to_invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Validate" name="Validate">
      <bpmn:incoming>Fc_xor_to_valid</bpmn:incoming>
      <bpmn:outgoing>Fc_v1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Store" name="Store">
      <bpmn:incoming>Fc_v1</bpmn:incoming>
      <bpmn:outgoing>Fc_v2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_LogInvalid" name="LogInvalid">
      <bpmn:incoming>Fc_xor_to_invalid</bpmn:incoming>
      <bpmn:outgoing>Fc_i1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Discard" name="Discard">
      <bpmn:incoming>Fc_i1</bpmn:incoming>
      <bpmn:outgoing>Fc_i2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="XOR_Valid_Merge">
      <bpmn:incoming>Fc_v2</bpmn:incoming>
      <bpmn:incoming>Fc_i2</bpmn:incoming>
      <bpmn:outgoing>Fc_msg_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 2: timer 10s → UseDefault → LogTimeout -->
    <bpmn:intermediateCatchEvent id="Evt_Timer10" name="10sec">
      <bpmn:incoming>Fc_to_timer</bpmn:incoming>
      <bpmn:outgoing>Fc_t1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_10">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">10</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_UseDefault" name="UseDefault">
      <bpmn:incoming>Fc_t1</bpmn:incoming>
      <bpmn:outgoing>Fc_t2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_LogTimeout" name="LogTimeout">
      <bpmn:incoming>Fc_t2</bpmn:incoming>
      <bpmn:outgoing>Fc_timer_done</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- EB merge (XOR) -->
    <bpmn:exclusiveGateway id="XOR_EB_Merge">
      <bpmn:incoming>Fc_msg_done</bpmn:incoming>
      <bpmn:incoming>Fc_timer_done</bpmn:incoming>
      <bpmn:outgoing>Fc_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Report" name="Report">
      <bpmn:incoming>Fc_end</bpmn:incoming>
      <bpmn:outgoing>Fc_final</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_C" name="end">
      <bpmn:incoming>Fc_final</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Fc_1" sourceRef="Start_C" targetRef="Task_Init" />
    <bpmn:sequenceFlow id="Fc_2" sourceRef="Task_Init" targetRef="EB_Wait" />
    <bpmn:sequenceFlow id="Fc_to_msg" sourceRef="EB_Wait" targetRef="Evt_CatchData" />
    <bpmn:sequenceFlow id="Fc_to_timer" sourceRef="EB_Wait" targetRef="Evt_Timer10" />
    <bpmn:sequenceFlow id="Fc_msg_to_xor" sourceRef="Evt_CatchData" targetRef="XOR_Valid_Split" />
    <bpmn:sequenceFlow id="Fc_xor_to_valid" sourceRef="XOR_Valid_Split" targetRef="Task_Validate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isValid == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fc_xor_to_invalid" sourceRef="XOR_Valid_Split" targetRef="Task_LogInvalid" />
    <bpmn:sequenceFlow id="Fc_v1" sourceRef="Task_Validate" targetRef="Task_Store" />
    <bpmn:sequenceFlow id="Fc_v2" sourceRef="Task_Store" targetRef="XOR_Valid_Merge" />
    <bpmn:sequenceFlow id="Fc_i1" sourceRef="Task_LogInvalid" targetRef="Task_Discard" />
    <bpmn:sequenceFlow id="Fc_i2" sourceRef="Task_Discard" targetRef="XOR_Valid_Merge" />
    <bpmn:sequenceFlow id="Fc_msg_done" sourceRef="XOR_Valid_Merge" targetRef="XOR_EB_Merge" />
    <bpmn:sequenceFlow id="Fc_t1" sourceRef="Evt_Timer10" targetRef="Task_UseDefault" />
    <bpmn:sequenceFlow id="Fc_t2" sourceRef="Task_UseDefault" targetRef="Task_LogTimeout" />
    <bpmn:sequenceFlow id="Fc_timer_done" sourceRef="Task_LogTimeout" targetRef="XOR_EB_Merge" />
    <bpmn:sequenceFlow id="Fc_end" sourceRef="XOR_EB_Merge" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="Fc_final" sourceRef="Task_Report" targetRef="End_C" />
  </bpmn:process>

  <bpmn:message id="Msg_Data" name="Msg_Data" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_EB4">
      <bpmndi:BPMNShape id="Part_Producer_di" bpmnElement="Part_Producer" isHorizontal="true"><dc:Bounds x="160" y="60" width="700" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Consumer_di" bpmnElement="Part_Consumer" isHorizontal="true"><dc:Bounds x="160" y="290" width="1050" height="400" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_P_di" bpmnElement="Start_P"><dc:Bounds x="222" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Build_di" bpmnElement="Task_Build"><dc:Bounds x="310" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_SendData_di" bpmnElement="Evt_SendData"><dc:Bounds x="462" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm"><dc:Bounds x="550" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_P_di" bpmnElement="End_P"><dc:Bounds x="702" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_C_di" bpmnElement="Start_C"><dc:Bounds x="222" y="452" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Init_di" bpmnElement="Task_Init"><dc:Bounds x="290" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EB_Wait_di" bpmnElement="EB_Wait"><dc:Bounds x="425" y="445" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_CatchData_di" bpmnElement="Evt_CatchData"><dc:Bounds x="512" y="372" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Valid_Split_di" bpmnElement="XOR_Valid_Split" isMarkerVisible="true"><dc:Bounds x="585" y="365" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate"><dc:Bounds x="670" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Store_di" bpmnElement="Task_Store"><dc:Bounds x="800" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogInvalid_di" bpmnElement="Task_LogInvalid"><dc:Bounds x="670" y="420" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Discard_di" bpmnElement="Task_Discard"><dc:Bounds x="800" y="420" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Valid_Merge_di" bpmnElement="XOR_Valid_Merge" isMarkerVisible="true"><dc:Bounds x="935" y="365" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_Timer10_di" bpmnElement="Evt_Timer10"><dc:Bounds x="512" y="562" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UseDefault_di" bpmnElement="Task_UseDefault"><dc:Bounds x="580" y="540" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogTimeout_di" bpmnElement="Task_LogTimeout"><dc:Bounds x="720" y="540" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_EB_Merge_di" bpmnElement="XOR_EB_Merge" isMarkerVisible="true"><dc:Bounds x="1015" y="445" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Report_di" bpmnElement="Task_Report"><dc:Bounds x="1090" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_C_di" bpmnElement="End_C"><dc:Bounds x="1222" y="452" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Fp_1_di" bpmnElement="Fp_1"><di:waypoint x="258" y="140" /><di:waypoint x="310" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fp_2_di" bpmnElement="Fp_2"><di:waypoint x="410" y="140" /><di:waypoint x="462" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fp_3_di" bpmnElement="Fp_3"><di:waypoint x="498" y="140" /><di:waypoint x="550" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fp_4_di" bpmnElement="Fp_4"><di:waypoint x="650" y="140" /><di:waypoint x="702" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_1_di" bpmnElement="Fc_1"><di:waypoint x="258" y="470" /><di:waypoint x="290" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_2_di" bpmnElement="Fc_2"><di:waypoint x="390" y="470" /><di:waypoint x="425" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_to_msg_di" bpmnElement="Fc_to_msg"><di:waypoint x="450" y="445" /><di:waypoint x="450" y="390" /><di:waypoint x="512" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_to_timer_di" bpmnElement="Fc_to_timer"><di:waypoint x="450" y="495" /><di:waypoint x="450" y="580" /><di:waypoint x="512" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_msg_to_xor_di" bpmnElement="Fc_msg_to_xor"><di:waypoint x="548" y="390" /><di:waypoint x="585" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_xor_to_valid_di" bpmnElement="Fc_xor_to_valid"><di:waypoint x="610" y="365" /><di:waypoint x="610" y="350" /><di:waypoint x="670" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_xor_to_invalid_di" bpmnElement="Fc_xor_to_invalid"><di:waypoint x="610" y="415" /><di:waypoint x="610" y="460" /><di:waypoint x="670" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_v1_di" bpmnElement="Fc_v1"><di:waypoint x="770" y="350" /><di:waypoint x="800" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_v2_di" bpmnElement="Fc_v2"><di:waypoint x="900" y="350" /><di:waypoint x="960" y="350" /><di:waypoint x="960" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_i1_di" bpmnElement="Fc_i1"><di:waypoint x="770" y="460" /><di:waypoint x="800" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_i2_di" bpmnElement="Fc_i2"><di:waypoint x="900" y="460" /><di:waypoint x="960" y="460" /><di:waypoint x="960" y="415" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_msg_done_di" bpmnElement="Fc_msg_done"><di:waypoint x="985" y="390" /><di:waypoint x="1040" y="390" /><di:waypoint x="1040" y="445" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_t1_di" bpmnElement="Fc_t1"><di:waypoint x="548" y="580" /><di:waypoint x="580" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_t2_di" bpmnElement="Fc_t2"><di:waypoint x="680" y="580" /><di:waypoint x="720" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_timer_done_di" bpmnElement="Fc_timer_done"><di:waypoint x="820" y="580" /><di:waypoint x="1040" y="580" /><di:waypoint x="1040" y="495" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_end_di" bpmnElement="Fc_end"><di:waypoint x="1065" y="470" /><di:waypoint x="1090" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fc_final_di" bpmnElement="Fc_final"><di:waypoint x="1190" y="470" /><di:waypoint x="1222" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Data_di" bpmnElement="MF_Data"><di:waypoint x="480" y="158" /><di:waypoint x="530" y="372" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
