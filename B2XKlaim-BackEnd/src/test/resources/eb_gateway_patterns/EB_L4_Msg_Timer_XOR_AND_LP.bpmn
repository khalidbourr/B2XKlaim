<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_L4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:collaboration id="Collab_L4">
    <bpmn:participant id="Part_Trigger" name="Trigger" processRef="Proc_Trigger" />
    <bpmn:participant id="Part_Engine" name="Engine" processRef="Proc_Engine" />
    <bpmn:messageFlow id="MF_Signal" name="signal" sourceRef="Evt_SendSignal" targetRef="Evt_CatchSignal" />
  </bpmn:collaboration>

  <!-- Trigger: Start → Prepare(ST) → SendSignal(MIT) → Done(ST) → End -->
  <bpmn:process id="Proc_Trigger" name="TriggerProc" isExecutable="false">
    <bpmn:startEvent id="Start_T" name="start">
      <bpmn:outgoing>Ft_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_PrepTrig" name="PrepareSignal">
      <bpmn:incoming>Ft_1</bpmn:incoming>
      <bpmn:outgoing>Ft_2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Evt_SendSignal" name="sendSignal">
      <bpmn:incoming>Ft_2</bpmn:incoming>
      <bpmn:outgoing>Ft_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_SendSig" messageRef="Msg_Signal" />
    </bpmn:intermediateThrowEvent>
    <bpmn:scriptTask id="Task_DoneTrig" name="TriggerDone">
      <bpmn:incoming>Ft_3</bpmn:incoming>
      <bpmn:outgoing>Ft_4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_T" name="end">
      <bpmn:incoming>Ft_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Ft_1" sourceRef="Start_T" targetRef="Task_PrepTrig" />
    <bpmn:sequenceFlow id="Ft_2" sourceRef="Task_PrepTrig" targetRef="Evt_SendSignal" />
    <bpmn:sequenceFlow id="Ft_3" sourceRef="Evt_SendSignal" targetRef="Task_DoneTrig" />
    <bpmn:sequenceFlow id="Ft_4" sourceRef="Task_DoneTrig" targetRef="End_T" />
  </bpmn:process>

  <!-- Engine: Start → Boot(ST) → EB Gateway(L1) →
         Path1 (msg): CatchSignal → XOR(L2) →
             (cond): AND(L3) →
                 Branch1: Loop(L4)(Scan(ST)→Check(ST)) → Validate(ST)
                 Branch2: Monitor(ST) → Record(ST)
               → AND merge → Publish(ST)
             (default): Skip(ST) → LogSkip(ST)
           → XOR merge → Confirm(ST)
         Path2 (timer 25s): Expire(ST) → Abort(ST)
       → XOR merge(EB) → Shutdown(ST) → End

       L1 = EB
       L2 = XOR inside msg path
       L3 = AND inside XOR true branch
       L4 = LP inside AND branch1
  -->
  <bpmn:process id="Proc_Engine" name="EngineProc" isExecutable="false">
    <bpmn:startEvent id="Start_E" name="start">
      <bpmn:outgoing>Fe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Boot" name="Boot">
      <bpmn:incoming>Fe_1</bpmn:incoming>
      <bpmn:outgoing>Fe_2</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L1: EB Gateway -->
    <bpmn:eventBasedGateway id="EB_Core">
      <bpmn:incoming>Fe_2</bpmn:incoming>
      <bpmn:outgoing>Fe_to_sig</bpmn:outgoing>
      <bpmn:outgoing>Fe_to_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- EB Path 1: msg → L2 XOR → ... → Confirm -->
    <bpmn:intermediateCatchEvent id="Evt_CatchSignal" name="getSignal">
      <bpmn:incoming>Fe_to_sig</bpmn:incoming>
      <bpmn:outgoing>Fe_sig_to_xor</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CatchSig" messageRef="Msg_Signal" />
    </bpmn:intermediateCatchEvent>

    <!-- L2: XOR split -->
    <bpmn:exclusiveGateway id="XOR_Route" default="Fe_xor_to_skip">
      <bpmn:incoming>Fe_sig_to_xor</bpmn:incoming>
      <bpmn:outgoing>Fe_xor_to_and</bpmn:outgoing>
      <bpmn:outgoing>Fe_xor_to_skip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- L2 Branch1 (cond) → L3: AND split -->
    <bpmn:parallelGateway id="AND_Work">
      <bpmn:incoming>Fe_xor_to_and</bpmn:incoming>
      <bpmn:outgoing>Fe_and_to_loop</bpmn:outgoing>
      <bpmn:outgoing>Fe_and_to_monitor</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- L3 AND Branch1 → L4: Loop(Scan→Check) → Validate -->
    <bpmn:exclusiveGateway id="LP_Merge">
      <bpmn:incoming>Fe_and_to_loop</bpmn:incoming>
      <bpmn:incoming>Fe_loop_back</bpmn:incoming>
      <bpmn:outgoing>Fe_lm_to_scan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Scan" name="ScanSector">
      <bpmn:incoming>Fe_lm_to_scan</bpmn:incoming>
      <bpmn:outgoing>Fe_scan_to_check</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Check" name="CheckResult">
      <bpmn:incoming>Fe_scan_to_check</bpmn:incoming>
      <bpmn:outgoing>Fe_check_to_lsplit</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="LP_Split" default="Fe_loop_exit">
      <bpmn:incoming>Fe_check_to_lsplit</bpmn:incoming>
      <bpmn:outgoing>Fe_loop_back</bpmn:outgoing>
      <bpmn:outgoing>Fe_loop_exit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Validate" name="ValidateAll">
      <bpmn:incoming>Fe_loop_exit</bpmn:incoming>
      <bpmn:outgoing>Fe_val_to_andmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L3 AND Branch2: Monitor → Record -->
    <bpmn:scriptTask id="Task_Monitor" name="MonitorLoad">
      <bpmn:incoming>Fe_and_to_monitor</bpmn:incoming>
      <bpmn:outgoing>Fe_mon1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Record" name="RecordMetrics">
      <bpmn:incoming>Fe_mon1</bpmn:incoming>
      <bpmn:outgoing>Fe_rec_to_andmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L3: AND merge -->
    <bpmn:parallelGateway id="AND_Merge_Work">
      <bpmn:incoming>Fe_val_to_andmerge</bpmn:incoming>
      <bpmn:incoming>Fe_rec_to_andmerge</bpmn:incoming>
      <bpmn:outgoing>Fe_and_done</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="Task_Publish" name="PublishResult">
      <bpmn:incoming>Fe_and_done</bpmn:incoming>
      <bpmn:outgoing>Fe_pub_to_xmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L2 Branch2 (default): Skip → LogSkip -->
    <bpmn:scriptTask id="Task_Skip" name="SkipProcessing">
      <bpmn:incoming>Fe_xor_to_skip</bpmn:incoming>
      <bpmn:outgoing>Fe_skip1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_LogSkip" name="LogSkipped">
      <bpmn:incoming>Fe_skip1</bpmn:incoming>
      <bpmn:outgoing>Fe_logskip_to_xmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L2: XOR merge -->
    <bpmn:exclusiveGateway id="XOR_Merge_Route">
      <bpmn:incoming>Fe_pub_to_xmerge</bpmn:incoming>
      <bpmn:incoming>Fe_logskip_to_xmerge</bpmn:incoming>
      <bpmn:outgoing>Fe_xm_to_confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Confirm" name="ConfirmDone">
      <bpmn:incoming>Fe_xm_to_confirm</bpmn:incoming>
      <bpmn:outgoing>Fe_confirm_to_ebmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- EB Path 2: timer 25s → Expire → Abort -->
    <bpmn:intermediateCatchEvent id="Evt_Timer25" name="25sec">
      <bpmn:incoming>Fe_to_timer</bpmn:incoming>
      <bpmn:outgoing>Fe_tm1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_25">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">25</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_Expire" name="HandleExpiry">
      <bpmn:incoming>Fe_tm1</bpmn:incoming>
      <bpmn:outgoing>Fe_tm2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Abort" name="AbortAll">
      <bpmn:incoming>Fe_tm2</bpmn:incoming>
      <bpmn:outgoing>Fe_abort_to_ebmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L1: EB closing XOR merge -->
    <bpmn:exclusiveGateway id="XOR_EB_Final">
      <bpmn:incoming>Fe_confirm_to_ebmerge</bpmn:incoming>
      <bpmn:incoming>Fe_abort_to_ebmerge</bpmn:incoming>
      <bpmn:outgoing>Fe_eb_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Shutdown" name="Shutdown">
      <bpmn:incoming>Fe_eb_done</bpmn:incoming>
      <bpmn:outgoing>Fe_final</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_E" name="end">
      <bpmn:incoming>Fe_final</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Fe_1" sourceRef="Start_E" targetRef="Task_Boot" />
    <bpmn:sequenceFlow id="Fe_2" sourceRef="Task_Boot" targetRef="EB_Core" />
    <bpmn:sequenceFlow id="Fe_to_sig" sourceRef="EB_Core" targetRef="Evt_CatchSignal" />
    <bpmn:sequenceFlow id="Fe_to_timer" sourceRef="EB_Core" targetRef="Evt_Timer25" />
    <bpmn:sequenceFlow id="Fe_sig_to_xor" sourceRef="Evt_CatchSignal" targetRef="XOR_Route" />
    <bpmn:sequenceFlow id="Fe_xor_to_and" sourceRef="XOR_Route" targetRef="AND_Work">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">payload != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fe_xor_to_skip" sourceRef="XOR_Route" targetRef="Task_Skip" />
    <bpmn:sequenceFlow id="Fe_and_to_loop" sourceRef="AND_Work" targetRef="LP_Merge" />
    <bpmn:sequenceFlow id="Fe_and_to_monitor" sourceRef="AND_Work" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="Fe_lm_to_scan" sourceRef="LP_Merge" targetRef="Task_Scan" />
    <bpmn:sequenceFlow id="Fe_scan_to_check" sourceRef="Task_Scan" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Fe_check_to_lsplit" sourceRef="Task_Check" targetRef="LP_Split" />
    <bpmn:sequenceFlow id="Fe_loop_back" sourceRef="LP_Split" targetRef="LP_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasMoreSectors == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fe_loop_exit" sourceRef="LP_Split" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Fe_val_to_andmerge" sourceRef="Task_Validate" targetRef="AND_Merge_Work" />
    <bpmn:sequenceFlow id="Fe_mon1" sourceRef="Task_Monitor" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Fe_rec_to_andmerge" sourceRef="Task_Record" targetRef="AND_Merge_Work" />
    <bpmn:sequenceFlow id="Fe_and_done" sourceRef="AND_Merge_Work" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Fe_pub_to_xmerge" sourceRef="Task_Publish" targetRef="XOR_Merge_Route" />
    <bpmn:sequenceFlow id="Fe_skip1" sourceRef="Task_Skip" targetRef="Task_LogSkip" />
    <bpmn:sequenceFlow id="Fe_logskip_to_xmerge" sourceRef="Task_LogSkip" targetRef="XOR_Merge_Route" />
    <bpmn:sequenceFlow id="Fe_xm_to_confirm" sourceRef="XOR_Merge_Route" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Fe_confirm_to_ebmerge" sourceRef="Task_Confirm" targetRef="XOR_EB_Final" />
    <bpmn:sequenceFlow id="Fe_tm1" sourceRef="Evt_Timer25" targetRef="Task_Expire" />
    <bpmn:sequenceFlow id="Fe_tm2" sourceRef="Task_Expire" targetRef="Task_Abort" />
    <bpmn:sequenceFlow id="Fe_abort_to_ebmerge" sourceRef="Task_Abort" targetRef="XOR_EB_Final" />
    <bpmn:sequenceFlow id="Fe_eb_done" sourceRef="XOR_EB_Final" targetRef="Task_Shutdown" />
    <bpmn:sequenceFlow id="Fe_final" sourceRef="Task_Shutdown" targetRef="End_E" />
  </bpmn:process>

  <bpmn:message id="Msg_Signal" name="Msg_Signal" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_L4">
      <bpmndi:BPMNShape id="Part_Trigger_di" bpmnElement="Part_Trigger" isHorizontal="true"><dc:Bounds x="160" y="60" width="700" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Engine_di" bpmnElement="Part_Engine" isHorizontal="true"><dc:Bounds x="160" y="290" width="1500" height="550" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_T_di" bpmnElement="Start_T"><dc:Bounds x="222" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepTrig_di" bpmnElement="Task_PrepTrig"><dc:Bounds x="310" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_SendSignal_di" bpmnElement="Evt_SendSignal"><dc:Bounds x="462" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DoneTrig_di" bpmnElement="Task_DoneTrig"><dc:Bounds x="550" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_T_di" bpmnElement="End_T"><dc:Bounds x="702" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_E_di" bpmnElement="Start_E"><dc:Bounds x="222" y="532" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Boot_di" bpmnElement="Task_Boot"><dc:Bounds x="290" y="510" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EB_Core_di" bpmnElement="EB_Core"><dc:Bounds x="425" y="525" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_CatchSignal_di" bpmnElement="Evt_CatchSignal"><dc:Bounds x="512" y="432" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Route_di" bpmnElement="XOR_Route" isMarkerVisible="true"><dc:Bounds x="585" y="425" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AND_Work_di" bpmnElement="AND_Work"><dc:Bounds x="675" y="365" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LP_Merge_di" bpmnElement="LP_Merge" isMarkerVisible="true"><dc:Bounds x="755" y="325" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scan_di" bpmnElement="Task_Scan"><dc:Bounds x="840" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check"><dc:Bounds x="970" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LP_Split_di" bpmnElement="LP_Split" isMarkerVisible="true"><dc:Bounds x="1095" y="325" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate"><dc:Bounds x="1170" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Monitor_di" bpmnElement="Task_Monitor"><dc:Bounds x="760" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Record_di" bpmnElement="Task_Record"><dc:Bounds x="890" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AND_Merge_Work_di" bpmnElement="AND_Merge_Work"><dc:Bounds x="1295" y="365" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish"><dc:Bounds x="1370" y="350" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Skip_di" bpmnElement="Task_Skip"><dc:Bounds x="760" y="540" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogSkip_di" bpmnElement="Task_LogSkip"><dc:Bounds x="890" y="540" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Merge_Route_di" bpmnElement="XOR_Merge_Route" isMarkerVisible="true"><dc:Bounds x="1495" y="425" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm"><dc:Bounds x="1570" y="410" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_Timer25_di" bpmnElement="Evt_Timer25"><dc:Bounds x="512" y="702" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Expire_di" bpmnElement="Task_Expire"><dc:Bounds x="590" y="680" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Abort_di" bpmnElement="Task_Abort"><dc:Bounds x="730" y="680" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_EB_Final_di" bpmnElement="XOR_EB_Final" isMarkerVisible="true"><dc:Bounds x="1695" y="525" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Shutdown_di" bpmnElement="Task_Shutdown"><dc:Bounds x="1770" y="510" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_E_di" bpmnElement="End_E"><dc:Bounds x="1895" y="532" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ft_1_di" bpmnElement="Ft_1"><di:waypoint x="258" y="140" /><di:waypoint x="310" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ft_2_di" bpmnElement="Ft_2"><di:waypoint x="410" y="140" /><di:waypoint x="462" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ft_3_di" bpmnElement="Ft_3"><di:waypoint x="498" y="140" /><di:waypoint x="550" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ft_4_di" bpmnElement="Ft_4"><di:waypoint x="650" y="140" /><di:waypoint x="702" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_1_di" bpmnElement="Fe_1"><di:waypoint x="258" y="550" /><di:waypoint x="290" y="550" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_2_di" bpmnElement="Fe_2"><di:waypoint x="390" y="550" /><di:waypoint x="425" y="550" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_to_sig_di" bpmnElement="Fe_to_sig"><di:waypoint x="450" y="525" /><di:waypoint x="450" y="450" /><di:waypoint x="512" y="450" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_to_timer_di" bpmnElement="Fe_to_timer"><di:waypoint x="450" y="575" /><di:waypoint x="450" y="720" /><di:waypoint x="512" y="720" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_sig_to_xor_di" bpmnElement="Fe_sig_to_xor"><di:waypoint x="548" y="450" /><di:waypoint x="585" y="450" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_xor_to_and_di" bpmnElement="Fe_xor_to_and"><di:waypoint x="610" y="425" /><di:waypoint x="610" y="390" /><di:waypoint x="675" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_xor_to_skip_di" bpmnElement="Fe_xor_to_skip"><di:waypoint x="610" y="475" /><di:waypoint x="610" y="580" /><di:waypoint x="760" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_and_to_loop_di" bpmnElement="Fe_and_to_loop"><di:waypoint x="700" y="365" /><di:waypoint x="700" y="350" /><di:waypoint x="755" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_and_to_monitor_di" bpmnElement="Fe_and_to_monitor"><di:waypoint x="700" y="415" /><di:waypoint x="700" y="470" /><di:waypoint x="760" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_lm_to_scan_di" bpmnElement="Fe_lm_to_scan"><di:waypoint x="805" y="350" /><di:waypoint x="840" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_scan_to_check_di" bpmnElement="Fe_scan_to_check"><di:waypoint x="940" y="350" /><di:waypoint x="970" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_check_to_lsplit_di" bpmnElement="Fe_check_to_lsplit"><di:waypoint x="1070" y="350" /><di:waypoint x="1095" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_loop_back_di" bpmnElement="Fe_loop_back"><di:waypoint x="1120" y="325" /><di:waypoint x="1120" y="300" /><di:waypoint x="780" y="300" /><di:waypoint x="780" y="325" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fe_loop_exit_di" bpmnElement="Fe_loop_exit"><di:waypoint x="1145" y="350" /><di:waypoint x="1170" y="350" /></bpmndi:BPMNEdge>
