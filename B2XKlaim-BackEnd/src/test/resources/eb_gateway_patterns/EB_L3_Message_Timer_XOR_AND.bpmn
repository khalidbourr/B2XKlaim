<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_L3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:collaboration id="Collab_L3">
    <bpmn:participant id="Part_Master" name="Master" processRef="Proc_Master" />
    <bpmn:participant id="Part_Slave" name="Slave" processRef="Proc_Slave" />
    <bpmn:messageFlow id="MF_Job" name="job" sourceRef="Evt_SendJob" targetRef="Evt_CatchJob" />
  </bpmn:collaboration>

  <!-- Master: Start → Dispatch(ST) → SendJob(MIT) → Wait(ST) → End -->
  <bpmn:process id="Proc_Master" name="MasterProc" isExecutable="false">
    <bpmn:startEvent id="Start_M" name="start">
      <bpmn:outgoing>Fm_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Dispatch" name="Dispatch">
      <bpmn:incoming>Fm_1</bpmn:incoming>
      <bpmn:outgoing>Fm_2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Evt_SendJob" name="sendJob">
      <bpmn:incoming>Fm_2</bpmn:incoming>
      <bpmn:outgoing>Fm_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_SendJob" messageRef="Msg_Job" />
    </bpmn:intermediateThrowEvent>
    <bpmn:scriptTask id="Task_Wait" name="WaitCompletion">
      <bpmn:incoming>Fm_3</bpmn:incoming>
      <bpmn:outgoing>Fm_4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_M" name="end">
      <bpmn:incoming>Fm_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fm_1" sourceRef="Start_M" targetRef="Task_Dispatch" />
    <bpmn:sequenceFlow id="Fm_2" sourceRef="Task_Dispatch" targetRef="Evt_SendJob" />
    <bpmn:sequenceFlow id="Fm_3" sourceRef="Evt_SendJob" targetRef="Task_Wait" />
    <bpmn:sequenceFlow id="Fm_4" sourceRef="Task_Wait" targetRef="End_M" />
  </bpmn:process>

  <!-- Slave: Start → Ready(ST) → EB Gateway →
         Path1 (msg): CatchJob → XOR split →
             (cond): AND split → (Fetch(ST)→Transform(ST)) || (Audit(ST)→Log(ST)) → AND merge → Commit(ST)
             (default): Reject(ST) → NotifySkip(ST)
           → XOR merge → Ack(ST)
         Path2 (timer 20s): Timeout(ST) → Escalate(ST)
       → XOR merge(EB) → Finish(ST) → End

       L1 = EB gateway
       L2 = XOR inside msg path
       L3 = AND inside XOR true branch
  -->
  <bpmn:process id="Proc_Slave" name="SlaveProc" isExecutable="false">
    <bpmn:startEvent id="Start_S" name="start">
      <bpmn:outgoing>Fs_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Ready" name="Ready">
      <bpmn:incoming>Fs_1</bpmn:incoming>
      <bpmn:outgoing>Fs_2</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L1: EB Gateway -->
    <bpmn:eventBasedGateway id="EB_Main">
      <bpmn:incoming>Fs_2</bpmn:incoming>
      <bpmn:outgoing>Fs_to_job</bpmn:outgoing>
      <bpmn:outgoing>Fs_to_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- EB Path 1: message catch → L2: XOR → ... → Ack -->
    <bpmn:intermediateCatchEvent id="Evt_CatchJob" name="getJob">
      <bpmn:incoming>Fs_to_job</bpmn:incoming>
      <bpmn:outgoing>Fs_job_to_xor</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CatchJob" messageRef="Msg_Job" />
    </bpmn:intermediateCatchEvent>

    <!-- L2: XOR split -->
    <bpmn:exclusiveGateway id="XOR_Accept" default="Fs_xor_to_reject">
      <bpmn:incoming>Fs_job_to_xor</bpmn:incoming>
      <bpmn:outgoing>Fs_xor_to_and</bpmn:outgoing>
      <bpmn:outgoing>Fs_xor_to_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- L2 Branch1 (cond) → L3: AND split -->
    <bpmn:parallelGateway id="AND_Process">
      <bpmn:incoming>Fs_xor_to_and</bpmn:incoming>
      <bpmn:outgoing>Fs_and_to_fetch</bpmn:outgoing>
      <bpmn:outgoing>Fs_and_to_audit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <!-- L3 AND Branch1: Fetch → Transform -->
    <bpmn:scriptTask id="Task_Fetch" name="FetchData">
      <bpmn:incoming>Fs_and_to_fetch</bpmn:incoming>
      <bpmn:outgoing>Fs_f1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Transform" name="TransformData">
      <bpmn:incoming>Fs_f1</bpmn:incoming>
      <bpmn:outgoing>Fs_f2</bpmn:outgoing>
    </bpmn:scriptTask>
    <!-- L3 AND Branch2: Audit → Log -->
    <bpmn:scriptTask id="Task_Audit" name="AuditJob">
      <bpmn:incoming>Fs_and_to_audit</bpmn:incoming>
      <bpmn:outgoing>Fs_a1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Log" name="LogAudit">
      <bpmn:incoming>Fs_a1</bpmn:incoming>
      <bpmn:outgoing>Fs_a2</bpmn:outgoing>
    </bpmn:scriptTask>
    <!-- L3: AND merge -->
    <bpmn:parallelGateway id="AND_Merge_Process">
      <bpmn:incoming>Fs_f2</bpmn:incoming>
      <bpmn:incoming>Fs_a2</bpmn:incoming>
      <bpmn:outgoing>Fs_and_done</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="Task_Commit" name="CommitResult">
      <bpmn:incoming>Fs_and_done</bpmn:incoming>
      <bpmn:outgoing>Fs_commit_to_xmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L2 Branch2 (default): Reject → NotifySkip -->
    <bpmn:scriptTask id="Task_Reject" name="RejectJob">
      <bpmn:incoming>Fs_xor_to_reject</bpmn:incoming>
      <bpmn:outgoing>Fs_rej1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_NotifySkip" name="NotifySkip">
      <bpmn:incoming>Fs_rej1</bpmn:incoming>
      <bpmn:outgoing>Fs_rej_to_xmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L2: XOR merge -->
    <bpmn:exclusiveGateway id="XOR_Merge_Accept">
      <bpmn:incoming>Fs_commit_to_xmerge</bpmn:incoming>
      <bpmn:incoming>Fs_rej_to_xmerge</bpmn:incoming>
      <bpmn:outgoing>Fs_xmerge_to_ack</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Ack" name="SendAck">
      <bpmn:incoming>Fs_xmerge_to_ack</bpmn:incoming>
      <bpmn:outgoing>Fs_ack_to_ebmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- EB Path 2: timer 20s → Timeout → Escalate -->
    <bpmn:intermediateCatchEvent id="Evt_Timer20" name="20sec">
      <bpmn:incoming>Fs_to_timer</bpmn:incoming>
      <bpmn:outgoing>Fs_t1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_20">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">20</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_Timeout" name="HandleTimeout">
      <bpmn:incoming>Fs_t1</bpmn:incoming>
      <bpmn:outgoing>Fs_t2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Escalate" name="Escalate">
      <bpmn:incoming>Fs_t2</bpmn:incoming>
      <bpmn:outgoing>Fs_timer_to_ebmerge</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- L1: EB closing XOR merge -->
    <bpmn:exclusiveGateway id="XOR_EB_Close">
      <bpmn:incoming>Fs_ack_to_ebmerge</bpmn:incoming>
      <bpmn:incoming>Fs_timer_to_ebmerge</bpmn:incoming>
      <bpmn:outgoing>Fs_eb_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Finish" name="Finish">
      <bpmn:incoming>Fs_eb_done</bpmn:incoming>
      <bpmn:outgoing>Fs_final</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_S" name="end">
      <bpmn:incoming>Fs_final</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Fs_1" sourceRef="Start_S" targetRef="Task_Ready" />
    <bpmn:sequenceFlow id="Fs_2" sourceRef="Task_Ready" targetRef="EB_Main" />
    <bpmn:sequenceFlow id="Fs_to_job" sourceRef="EB_Main" targetRef="Evt_CatchJob" />
    <bpmn:sequenceFlow id="Fs_to_timer" sourceRef="EB_Main" targetRef="Evt_Timer20" />
    <bpmn:sequenceFlow id="Fs_job_to_xor" sourceRef="Evt_CatchJob" targetRef="XOR_Accept" />
    <bpmn:sequenceFlow id="Fs_xor_to_and" sourceRef="XOR_Accept" targetRef="AND_Process">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">canProcess == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fs_xor_to_reject" sourceRef="XOR_Accept" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Fs_and_to_fetch" sourceRef="AND_Process" targetRef="Task_Fetch" />
    <bpmn:sequenceFlow id="Fs_and_to_audit" sourceRef="AND_Process" targetRef="Task_Audit" />
    <bpmn:sequenceFlow id="Fs_f1" sourceRef="Task_Fetch" targetRef="Task_Transform" />
    <bpmn:sequenceFlow id="Fs_f2" sourceRef="Task_Transform" targetRef="AND_Merge_Process" />
    <bpmn:sequenceFlow id="Fs_a1" sourceRef="Task_Audit" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="Fs_a2" sourceRef="Task_Log" targetRef="AND_Merge_Process" />
    <bpmn:sequenceFlow id="Fs_and_done" sourceRef="AND_Merge_Process" targetRef="Task_Commit" />
    <bpmn:sequenceFlow id="Fs_commit_to_xmerge" sourceRef="Task_Commit" targetRef="XOR_Merge_Accept" />
    <bpmn:sequenceFlow id="Fs_rej1" sourceRef="Task_Reject" targetRef="Task_NotifySkip" />
    <bpmn:sequenceFlow id="Fs_rej_to_xmerge" sourceRef="Task_NotifySkip" targetRef="XOR_Merge_Accept" />
    <bpmn:sequenceFlow id="Fs_xmerge_to_ack" sourceRef="XOR_Merge_Accept" targetRef="Task_Ack" />
    <bpmn:sequenceFlow id="Fs_ack_to_ebmerge" sourceRef="Task_Ack" targetRef="XOR_EB_Close" />
    <bpmn:sequenceFlow id="Fs_t1" sourceRef="Evt_Timer20" targetRef="Task_Timeout" />
    <bpmn:sequenceFlow id="Fs_t2" sourceRef="Task_Timeout" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Fs_timer_to_ebmerge" sourceRef="Task_Escalate" targetRef="XOR_EB_Close" />
    <bpmn:sequenceFlow id="Fs_eb_done" sourceRef="XOR_EB_Close" targetRef="Task_Finish" />
    <bpmn:sequenceFlow id="Fs_final" sourceRef="Task_Finish" targetRef="End_S" />
  </bpmn:process>

  <bpmn:message id="Msg_Job" name="Msg_Job" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_L3">
      <bpmndi:BPMNShape id="Part_Master_di" bpmnElement="Part_Master" isHorizontal="true"><dc:Bounds x="160" y="60" width="700" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Slave_di" bpmnElement="Part_Slave" isHorizontal="true"><dc:Bounds x="160" y="290" width="1300" height="500" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_M_di" bpmnElement="Start_M"><dc:Bounds x="222" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Dispatch_di" bpmnElement="Task_Dispatch"><dc:Bounds x="310" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_SendJob_di" bpmnElement="Evt_SendJob"><dc:Bounds x="462" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Wait_di" bpmnElement="Task_Wait"><dc:Bounds x="550" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_M_di" bpmnElement="End_M"><dc:Bounds x="702" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_S_di" bpmnElement="Start_S"><dc:Bounds x="222" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ready_di" bpmnElement="Task_Ready"><dc:Bounds x="290" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EB_Main_di" bpmnElement="EB_Main"><dc:Bounds x="425" y="495" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_CatchJob_di" bpmnElement="Evt_CatchJob"><dc:Bounds x="512" y="412" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Accept_di" bpmnElement="XOR_Accept" isMarkerVisible="true"><dc:Bounds x="585" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AND_Process_di" bpmnElement="AND_Process"><dc:Bounds x="675" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fetch_di" bpmnElement="Task_Fetch"><dc:Bounds x="760" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Transform_di" bpmnElement="Task_Transform"><dc:Bounds x="890" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Audit_di" bpmnElement="Task_Audit"><dc:Bounds x="760" y="410" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Log_di" bpmnElement="Task_Log"><dc:Bounds x="890" y="410" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AND_Merge_Process_di" bpmnElement="AND_Merge_Process"><dc:Bounds x="1020" y="345" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Commit_di" bpmnElement="Task_Commit"><dc:Bounds x="1095" y="330" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject"><dc:Bounds x="760" y="510" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifySkip_di" bpmnElement="Task_NotifySkip"><dc:Bounds x="890" y="510" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_Merge_Accept_di" bpmnElement="XOR_Merge_Accept" isMarkerVisible="true"><dc:Bounds x="1220" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ack_di" bpmnElement="Task_Ack"><dc:Bounds x="1295" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evt_Timer20_di" bpmnElement="Evt_Timer20"><dc:Bounds x="512" y="652" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Timeout_di" bpmnElement="Task_Timeout"><dc:Bounds x="590" y="630" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate"><dc:Bounds x="730" y="630" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XOR_EB_Close_di" bpmnElement="XOR_EB_Close" isMarkerVisible="true"><dc:Bounds x="1420" y="495" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Finish_di" bpmnElement="Task_Finish"><dc:Bounds x="1495" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_S_di" bpmnElement="End_S"><dc:Bounds x="1622" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Fm_1_di" bpmnElement="Fm_1"><di:waypoint x="258" y="140" /><di:waypoint x="310" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fm_2_di" bpmnElement="Fm_2"><di:waypoint x="410" y="140" /><di:waypoint x="462" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fm_3_di" bpmnElement="Fm_3"><di:waypoint x="498" y="140" /><di:waypoint x="550" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fm_4_di" bpmnElement="Fm_4"><di:waypoint x="650" y="140" /><di:waypoint x="702" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_1_di" bpmnElement="Fs_1"><di:waypoint x="258" y="520" /><di:waypoint x="290" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_2_di" bpmnElement="Fs_2"><di:waypoint x="390" y="520" /><di:waypoint x="425" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_to_job_di" bpmnElement="Fs_to_job"><di:waypoint x="450" y="495" /><di:waypoint x="450" y="430" /><di:waypoint x="512" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_to_timer_di" bpmnElement="Fs_to_timer"><di:waypoint x="450" y="545" /><di:waypoint x="450" y="670" /><di:waypoint x="512" y="670" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_job_to_xor_di" bpmnElement="Fs_job_to_xor"><di:waypoint x="548" y="430" /><di:waypoint x="585" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_xor_to_and_di" bpmnElement="Fs_xor_to_and"><di:waypoint x="610" y="405" /><di:waypoint x="610" y="370" /><di:waypoint x="675" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_xor_to_reject_di" bpmnElement="Fs_xor_to_reject"><di:waypoint x="610" y="455" /><di:waypoint x="610" y="550" /><di:waypoint x="760" y="550" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_and_to_fetch_di" bpmnElement="Fs_and_to_fetch"><di:waypoint x="700" y="345" /><di:waypoint x="700" y="350" /><di:waypoint x="760" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_and_to_audit_di" bpmnElement="Fs_and_to_audit"><di:waypoint x="700" y="395" /><di:waypoint x="700" y="450" /><di:waypoint x="760" y="450" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_f1_di" bpmnElement="Fs_f1"><di:waypoint x="860" y="350" /><di:waypoint x="890" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_f2_di" bpmnElement="Fs_f2"><di:waypoint x="990" y="350" /><di:waypoint x="1020" y="350" /><di:waypoint x="1020" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_a1_di" bpmnElement="Fs_a1"><di:waypoint x="860" y="450" /><di:waypoint x="890" y="450" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_a2_di" bpmnElement="Fs_a2"><di:waypoint x="990" y="450" /><di:waypoint x="1045" y="450" /><di:waypoint x="1045" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_and_done_di" bpmnElement="Fs_and_done"><di:waypoint x="1070" y="370" /><di:waypoint x="1095" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_commit_to_xmerge_di" bpmnElement="Fs_commit_to_xmerge"><di:waypoint x="1195" y="370" /><di:waypoint x="1245" y="370" /><di:waypoint x="1245" y="405" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_rej1_di" bpmnElement="Fs_rej1"><di:waypoint x="860" y="550" /><di:waypoint x="890" y="550" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_rej_to_xmerge_di" bpmnElement="Fs_rej_to_xmerge"><di:waypoint x="990" y="550" /><di:waypoint x="1245" y="550" /><di:waypoint x="1245" y="455" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_xmerge_to_ack_di" bpmnElement="Fs_xmerge_to_ack"><di:waypoint x="1270" y="430" /><di:waypoint x="1295" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_ack_to_ebmerge_di" bpmnElement="Fs_ack_to_ebmerge"><di:waypoint x="1395" y="430" /><di:waypoint x="1445" y="430" /><di:waypoint x="1445" y="495" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_t1_di" bpmnElement="Fs_t1"><di:waypoint x="548" y="670" /><di:waypoint x="590" y="670" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_t2_di" bpmnElement="Fs_t2"><di:waypoint x="690" y="670" /><di:waypoint x="730" y="670" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_timer_to_ebmerge_di" bpmnElement="Fs_timer_to_ebmerge"><di:waypoint x="830" y="670" /><di:waypoint x="1445" y="670" /><di:waypoint x="1445" y="545" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_eb_done_di" bpmnElement="Fs_eb_done"><di:waypoint x="1470" y="520" /><di:waypoint x="1495" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Fs_final_di" bpmnElement="Fs_final"><di:waypoint x="1595" y="520" /><di:waypoint x="1622" y="520" /></bpmndi:BPMNEdge>
